#!/bin/bash
#
# Live-ISO entry point for the KDX install orchestrator. Invoked from
# /root/.automated_script.sh after the configurator wizard has produced its
# user_*.json / user_*.txt files. The outer shim owns install logging.

set -eEo pipefail

# Parse our args; convert to env vars before exec'ing Python so archinstall's
# own argparse (which runs at module import time inside the orchestrator)
# doesn't choke on flags it doesn't recognize.
while [[ $# -gt 0 ]]; do
  case $1 in
    --config)               export KDX_INSTALL_CONFIG="$2"; shift 2 ;;
    --creds)                export KDX_INSTALL_CREDS="$2"; shift 2 ;;
    --encrypt-file)         export KDX_INSTALL_ENCRYPT_FILE="$2"; shift 2 ;;
    --authorized-keys-file) export KDX_INSTALL_AUTHORIZED_KEYS_FILE="$2"; shift 2 ;;
    --tailscale-authkey-file) export KDX_INSTALL_TAILSCALE_AUTHKEY_FILE="$2"; shift 2 ;;
    --defer-provisioning-file)             export KDX_INSTALL_DEFER_PROVISIONING_FILE="$2"; shift 2 ;;
    *)                      echo "kdx-iso-install: unknown arg $1" >&2; exit 2 ;;
  esac
done

cd /usr/share/kdx-iso
exec python -m orchestrator.main
