#!/bin/bash

set -e

NO_CACHE=""
KEEP_PKG_CACHE=""
LOCAL_KDX_PATH=""
LOCAL_PKGS_PATH=""
KDX_ARCH="${KDX_ARCH:-x86_64}"
N1X_DEV_SSH_KEY=""
PACKAGE_DIR=""
while [[ $# -gt 0 ]]; do
  case $1 in
  --arch)
    KDX_ARCH="${2:-}"
    case "$KDX_ARCH" in
    x86_64|aarch64) ;;
    *)
      echo "Error: --arch must be x86_64 or aarch64" >&2
      exit 1
      ;;
    esac
    shift 2
    ;;
  --dev-ssh)
    # DEV ONLY: bakes the given public key into an N1x image for key-only root
    # SSH on the live ISO and the installed system (builder/n1x-dev-ssh/).
    N1X_DEV_SSH_KEY="${2:-}"
    if [[ -z $N1X_DEV_SSH_KEY ]]; then
      echo "Error: --dev-ssh requires a public key file" >&2
      exit 1
    fi
    shift 2
    ;;
  --package-dir)
    # aarch64 packages that take precedence over the repositories: a kernel
    # under test, or anything pinned to a version proven on the hardware. The
    # directory must carry a SHA256SUMS covering every archive.
    PACKAGE_DIR="${2:-}"
    if [[ -z $PACKAGE_DIR ]]; then
      echo "Error: --package-dir requires a directory" >&2
      exit 1
    fi
    shift 2
    ;;
  --no-cache)
    NO_CACHE=1
    shift
    ;;
  --keep-pkg-cache)
    KEEP_PKG_CACHE=1
    shift
    ;;
  --no-boot-offer)
    NO_BOOT_OFFER=1
    shift
    ;;
  --debug)
    KDX_INSTALL_DEBUG=1
    shift
    ;;
  --edge)
    KDX_ISO_REF=edge
    KDX_MIRROR=edge
    shift
    ;;
  --local-source)
    LOCAL_KDX_PATH="${2:-}"
    LOCAL_PKGS_PATH="${3:-}"
    if [[ -z $LOCAL_KDX_PATH || -z $LOCAL_PKGS_PATH ]]; then
      echo "Error: --local-source requires two args: <kdx-checkout> <pkgs-checkout>" >&2
      exit 1
    fi
    KDX_MIRROR=edge
    KDX_ISO_REF=local
    shift 3
    ;;
  --dev)
    KDX_ISO_REF=dev
    KDX_MIRROR=edge
    shift
    ;;
  --quattro)
    KDX_INSTALLER_REF=quattro
    KDX_MIRROR=edge
    shift
    ;;
  --rc)
    KDX_ISO_REF=rc
    KDX_MIRROR=rc
    shift
    ;;
  *)
    echo "Unknown option: $1"
    echo "Usage: $0 [--no-cache] [--keep-pkg-cache] [--no-boot-offer] [--debug] [--edge] [--dev|--rc] [--local-source <kdx-checkout> <pkgs-checkout>]"
    echo "       $0 --arch aarch64 [--edge|--rc] [--package-dir DIR] [--dev-ssh <pubkey>] [--local-source <kdx-checkout> <pkgs-checkout>] [...]"
    exit 1
    ;;
  esac
done

if [[ -n $LOCAL_KDX_PATH ]]; then
  [[ -d $LOCAL_KDX_PATH ]] || { echo "Error: KDX checkout not found at $LOCAL_KDX_PATH" >&2; exit 1; }
  [[ -d $LOCAL_PKGS_PATH ]]    || { echo "Error: pkgs checkout not found at $LOCAL_PKGS_PATH" >&2; exit 1; }
  LOCAL_KDX_PATH=$(realpath "$LOCAL_KDX_PATH")
  LOCAL_PKGS_PATH=$(realpath "$LOCAL_PKGS_PATH")
fi

# Architecture selection. Both architectures boot linux-kdx live; x86_64
# also carries linux-t2 for Macs. aarch64 builds run in a pinned
# Arch Linux ARM container against KDX's aarch64 repository and its mirror
# of Arch Linux ARM in the build's channel, stable unless --rc or --edge says
# otherwise, as on x86_64, and make one image for every board, on the
# linux-kdx that repository publishes.
# build-iso.sh refuses a runtime without the platform support.
CONTAINER_IMAGE=ghcr.io/archlinux/archlinux:latest
CONTAINER_PLATFORM_ARGS=()
KDX_KERNEL=linux-kdx
if [[ $KDX_ARCH == aarch64 ]]; then
  if [[ -n $PACKAGE_DIR ]]; then
    [[ -d $PACKAGE_DIR ]] || { echo "Error: package directory not found at $PACKAGE_DIR" >&2; exit 1; }
    PACKAGE_DIR=$(realpath "$PACKAGE_DIR")
    if [[ ! -f $PACKAGE_DIR/SHA256SUMS ]]; then
      echo "Error: $PACKAGE_DIR must contain SHA256SUMS" >&2
      exit 1
    fi
    if ! (cd "$PACKAGE_DIR" && sha256sum --check --strict --quiet SHA256SUMS); then
      echo "Error: package bundle checksum verification failed in $PACKAGE_DIR" >&2
      exit 1
    fi
  fi
  if [[ -n $N1X_DEV_SSH_KEY ]]; then
    [[ -f $N1X_DEV_SSH_KEY ]] || { echo "Error: SSH public key not found at $N1X_DEV_SSH_KEY" >&2; exit 1; }
    N1X_DEV_SSH_KEY=$(realpath "$N1X_DEV_SSH_KEY")
    if ! grep -Eq '^(ssh-|ecdsa-|sk-)' "$N1X_DEV_SSH_KEY" || grep -Evq '^(ssh-|ecdsa-|sk-|#|$)' "$N1X_DEV_SSH_KEY"; then
      echo "Error: $N1X_DEV_SSH_KEY must hold public keys only, one per line" >&2
      exit 1
    fi
  fi
  # Pinned by digest: this container runs with the privileges archiso needs,
  # so a mutable third-party tag is not acceptable. From GitHub's registry:
  # the same build Menci pushes to Docker Hub, without Docker Hub's limit on
  # anonymous pulls, which failed the aarch64 jobs with 429s.
  CONTAINER_IMAGE=ghcr.io/menci/archlinuxarm@sha256:3e1074c407fc1a57c2a2117af6920c96a7cc906fa6f1f2da8a4a7fd3aa2c2f4e
  CONTAINER_PLATFORM_ARGS=(--platform linux/arm64)
elif [[ -n $PACKAGE_DIR || -n $N1X_DEV_SSH_KEY ]]; then
  echo "Error: --package-dir and --dev-ssh are only valid with --arch aarch64" >&2
  exit 1
fi

lint_file_permissions() {
  local profiledef="configs/profiledef.sh"
  local declared
  local missing=()

  declared=$(sed -n 's/^[[:space:]]*\["\([^"]*\)"\].*/\1/p' "$profiledef")

  while IFS= read -r f; do
    [[ -f $f ]] || continue

    local rel="${f#configs/airootfs}"
    local mode
    mode=$(git ls-files --stage -- "$f" | awk '{print $1}')

    if [[ $mode != 100755 && $(head -c 2 "$f") != "#!" ]]; then
      continue
    fi

    if ! grep -Fxq -- "$rel" <<<"$declared"; then
      missing+=("$rel")
    fi
  done < <(find configs/airootfs/usr/local/bin configs/airootfs/root -type f 2>/dev/null)

  if (( ${#missing[@]} > 0 )); then
    echo "ERROR: the following executable files are missing from $profiledef file_permissions:" >&2
    printf '  %s\n' "${missing[@]}" >&2
    echo "Add entries like [\"<path>\"]=\"0:0:755\" to profiledef.sh and retry." >&2
    exit 1
  fi
}

lint_file_permissions

# Purging the host package cache needs interactive sudo; --keep-pkg-cache
# skips it so unattended builds (test rigs, agents) can run without a prompt.
# aarch64 builds never touch the host cache (see below), so nothing to purge.
if [[ -z $KEEP_PKG_CACHE && $KDX_ARCH == x86_64 ]]; then
  sudo rm -rf /var/cache/pacman/pkg/*
fi
git submodule update --init --recursive --jobs=8

BUILD_SCRIPT="builder/build-iso.sh"
BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
BUILD_RELEASE_PATH="$BUILD_ROOT/release"
mkdir -p "$BUILD_RELEASE_PATH"

KDX_ISO_REF="${KDX_ISO_REF:-quattro}"
KDX_MIRROR="${KDX_MIRROR:-stable}"

DOCKER_ARGS=(
  --rm
  --privileged
  -e "KDX_ISO_REF=$KDX_ISO_REF"
  -e "KDX_MIRROR=$KDX_MIRROR"
  -e "KDX_INSTALL_DEBUG=${KDX_INSTALL_DEBUG:-}"
  -e "KDX_ARCH=$KDX_ARCH"
  -e "KDX_KERNEL=$KDX_KERNEL"
  -e "KDX_N1X_DEV_SSH=${N1X_DEV_SSH_KEY:+1}"
  # Optional overrides of the KDX package pair build-iso.sh installs, e.g.
  # the release recipes (kdx, kdx-settings) built from --local-source
  # instead of the -dev ones that track quattro.
  -e "KDX_RUNTIME_PACKAGE=${KDX_RUNTIME_PACKAGE:-}"
  -e "KDX_SETTINGS_PACKAGE=${KDX_SETTINGS_PACKAGE:-}"
  -e "HOST_UID=$(id -u)"
  -e "HOST_GID=$(id -g)"
  -v "$BUILD_RELEASE_PATH/:/out/"
  -v "$BUILD_ROOT/$BUILD_SCRIPT:/$BUILD_SCRIPT:ro"
  -v "$BUILD_ROOT/archiso:/archiso:ro"
  -v "$BUILD_ROOT/builder:/builder:ro"
  -v "$BUILD_ROOT/configs:/configs:ro"
)

if [[ -n $LOCAL_KDX_PATH ]]; then
  DOCKER_ARGS+=(
    -v "$LOCAL_KDX_PATH:/kdx-source:ro"
    -v "$LOCAL_PKGS_PATH:/kdx-pkgs:ro"
  )
fi

if [[ -n $PACKAGE_DIR ]]; then
  DOCKER_ARGS+=(-v "$PACKAGE_DIR:/packages:ro")
fi

if [[ -n $N1X_DEV_SSH_KEY ]]; then
  DOCKER_ARGS+=(-v "$N1X_DEV_SSH_KEY:/dev-ssh/authorized_keys:ro")
fi

# The host pacman cache belongs to the host architecture; sharing it with an
# aarch64 container would leak foreign packages into the offline mirror.
if [[ $KDX_ARCH == x86_64 && -d /var/cache/pacman/pkg ]]; then
  DOCKER_ARGS+=(-v "/var/cache/pacman/pkg:/var/cache/pacman/pkg")
fi

# Mount the build cache directory where packages are downloaded. Channels and
# architectures use different package snapshots and must never share an
# offline mirror cache.
if [[ -z "$NO_CACHE" ]]; then
  OFFLINE_REPO_BUILD_CACHE_DIR="$HOME/.cache/kdx/iso_${KDX_MIRROR}_${KDX_ARCH}/airootfs/var/cache/kdx"
  if [[ $KDX_ARCH == x86_64 ]]; then
    # Keep the historical cache path for x86_64 builds.
    OFFLINE_REPO_BUILD_CACHE_DIR="$HOME/.cache/kdx/iso_${KDX_MIRROR}/airootfs/var/cache/kdx"
  fi
  mkdir -p "$OFFLINE_REPO_BUILD_CACHE_DIR"
  DOCKER_ARGS+=(-v "$OFFLINE_REPO_BUILD_CACHE_DIR:/var/cache/airootfs/var/cache/kdx")
else
  # The locally cached :latest image is a cache too — docker run never
  # re-checks the registry for it, so refresh it when building cold.
  DOCKER_ARGS+=(--pull=always)
fi

# The docker group is root-equivalent, so KDX operators stay out of it on
# purpose. When the socket refuses the calling user, run the client through
# sudo instead of requiring group membership.
DOCKER=(docker)
if ! docker version &>/dev/null; then
  DOCKER=(sudo docker)
fi

"${DOCKER[@]}" run "${CONTAINER_PLATFORM_ARGS[@]}" "${DOCKER_ARGS[@]}" "$CONTAINER_IMAGE" /$BUILD_SCRIPT

latest_iso=$(\ls -t "$BUILD_RELEASE_PATH"/*.iso | head -n1)
if [[ $KDX_ARCH == aarch64 ]]; then
  iso_ref="${latest_iso%.*}${N1X_DEV_SSH_KEY:+-devssh}-$KDX_ISO_REF.iso"
else
  iso_ref="${latest_iso%.*}-$KDX_ISO_REF.iso"
fi
mv -f "$latest_iso" "$iso_ref"

if [[ -z "${NO_BOOT_OFFER:-}" ]]; then
  echo
  gum confirm "Boot $iso_ref?" && "$BUILD_ROOT/bin/kdx-iso-boot" "$iso_ref"
fi
